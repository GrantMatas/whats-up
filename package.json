{
  "name": "whats-up-local",
  "version": "0.4.1",
  "description": "Your local intelligence, beautifully connected.",
  "author": "What's Up",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --win nsis portable --publish never",
    "smoke": "node scripts/smoke.mjs",
    "audit:release": "node scripts/audit-release.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.2",
    "maplibre-gl": "^6.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "com.whatsup.local",
    "productName": "What's Up",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!node_modules/**/*.map",
      "!node_modules/**/{test,tests,fixtures,__tests__}/**",
      "!node_modules/**/*.{test,spec}.*",
      "!dist/shared/**",
      "!dist/renderer/assets/fixtures-*",
      "assets/app-icon.png",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/app-icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": true,
      "deleteAppDataOnUninstall": false,
      "include": "assets/installer.nsh"
    }
  },
  "license": "MIT"
}
